<?xml version="1.0" encoding="utf-8"?>
<!--
  Règles historiques d'Auto Backup. minSdk est 34 : le système lit
  data_extraction_rules.xml. Ce fichier reste pour le critère E1 et
  exclut les mêmes domaines.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
